# EIMS 生产环境配置示例
# 复制此文件为 .env，然后根据实际环境修改

# -------------------------- 核心配置（必须修改）--------------------------
# 调试模式（生产环境必须设为 False）
DEBUG=False

# 项目密钥（必须修改！生成命令见下方注释）
# 生成方法：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="在此粘贴生成的随机密钥"

# 允许的主机（必须修改！填写服务器 IP 和域名）
ALLOWED_HOSTS="your_server_ip,your_domain.com,localhost,127.0.0.1"

# -------------------------- 数据库配置（必须修改）--------------------------
# MySQL 数据库配置（取消注释并修改）
DB_NAME="eims_db"
DB_USER="eims_user"
DB_PASSWORD="your_secure_password"
DB_HOST="localhost"
DB_PORT="3306"

# -------------------------- 可选配置（通常无需修改）--------------------------
# 密码重置链接有效期（秒）
PASSWORD_RESET_TIMEOUT=3600

# 媒体文件存储路径
MEDIA_ROOT="./media"

# 静态文件存储路径
STATIC_ROOT="./staticfiles"

# -------------------------- 备注--------------------------
# 1. 标有【必须修改】的配置项请务必修改
# 2. SECRET_KEY 对安全性至关重要，切勿使用默认值
# 3. ALLOWED_HOSTS 防止主机头攻击，请填写实际的访问地址
# 4. 数据库密码请使用强密码（大小写字母 + 数字 + 特殊符号，至少 12 位）
