# Django 生产环境配置模板
# 复制此文件为 .env.prod 并根据实际情况修改

# -------------------------- 安全配置 --------------------------
# 生成新的 SECRET_KEY（非常重要！）
# 运行 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-production-secret-key-here

# 生产环境必须关闭 DEBUG
DJANGO_DEBUG=False

# 允许访问的主机名（逗号分隔）
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-server-ip

# -------------------------- 数据库配置 --------------------------
# 推荐使用 PostgreSQL 或 MySQL
DB_ENGINE=django.db.backends.postgresql  # 或 django.db.backends.mysql
DB_NAME=eims_db
DB_USER=eims_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432  # PostgreSQL 默认端口，MySQL 使用 3306

# -------------------------- 邮件配置（可选） --------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# -------------------------- 文件上传配置 --------------------------
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/eims/media/

# -------------------------- 静态文件配置 --------------------------
STATIC_URL=/static/
STATIC_ROOT=/var/www/eims/staticfiles/

# -------------------------- CSRF 配置 --------------------------
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
