@echo off
chcp 65001 >nul
echo ======================================
echo 重启云服务器 Django 服务
echo ======================================
echo.
echo 请输入服务器密码（root 用户的密码）：
echo.

echo 正在重启服务...
ssh root@39.106.41.239 @"
cd /var/www/eims
source venv/bin/activate

echo '======================================'
echo '步骤 1: 查看当前服务状态'
echo '======================================'
sudo supervisorctl status eims

echo.
echo '======================================'
echo '步骤 2: 重启服务'
echo '======================================'
sudo supervisorctl restart eims

echo.
echo '======================================'
echo '步骤 3: 等待服务启动'
echo '======================================'
sleep 3

echo.
echo '======================================'
echo '步骤 4: 查看服务状态'
echo '======================================'
sudo supervisorctl status eims

echo.
echo '======================================'
echo '步骤 5: 查看 Django 版本'
echo '======================================'
python -m django --version

echo.
echo '======================================'
echo '重启完成！'
echo '======================================'
"@

echo.
echo ======================================
echo 服务器重启命令已执行！
echo ======================================
echo.
echo 请在浏览器中访问：
echo http://39.106.41.239:8000/
echo.
echo 按 Ctrl+F5 强制刷新
echo.
pause
